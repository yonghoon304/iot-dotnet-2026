<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="스마트팩토리 모니터링 시스템" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" Grid.Row="0" materialDesign:ElevationAssist.Elevation="Dp2">
            <DockPanel>
                <Button Style="{StaticResource MaterialDesignToolButton}" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="Menu" />
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Bold">
                    System Dashboard
                </TextBlock>
                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignToolButton}" HorizontalAlignment="Right">
                    <materialDesign:PackIcon Kind="AccountCircle" />
                </Button>
            </DockPanel>
        </materialDesign:ColorZone>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
                <ListBox Margin="0,16,0,0">
                    <ListBoxItem Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeveloperBoard" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="디바이스 제어" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="센서 데이터 분석" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Console" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="시스템 터미널" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="환경 설정" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="ServerNetwork" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}" HorizontalAlignment="Center" Margin="0,0,0,8">
                        서버 연결 대기 중...
                    </TextBlock>
                    <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" HorizontalAlignment="Center" Margin="0,0,0,24" Foreground="{DynamicResource MaterialDesignBodyLight}">
                        라즈베리파이 및 엣지 디바이스의 통신 상태를 점검하세요.
                    </TextBlock>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Width="200" Content="연결 시도" materialDesign:ButtonAssist.CornerRadius="5"/>
                </StackPanel>

                <Button Style="{StaticResource MaterialDesignFloatingActionSecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                        ToolTip="새 장치 추가">
                    <materialDesign:PackIcon Kind="Plus" Width="24" Height="24"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>