<Page x:Class="WpfBasic02Navi.Menupage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfBasic02Navi"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="950"
      Title="Menupage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="SimpleControlPage" Margin="10,10,5,10" Width="150"/>
            <Button Content="Page01"/>
            <Button Content="Page01"/>
            <Button Content="Page01"/>
            <Button Content="Page01"/>

        </StackPanel>

        
        
        <DockPanel Grid.Row="2">
            <Button Content="Page12" DockPanel.Dock ="Top" />
            <Button Content="Page12" DockPanel.Dock ="Top" />
            <Button Content="Page12" DockPanel.Dock ="Top" />
        </DockPanel>

    </Grid>
</Page>